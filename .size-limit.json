[
  {
    "name": "main",
    "path": "dist/main.*.js",
    "limit": "27 kB",
    "gzip": true
  },
  {
    "name": "vendor",
    "path": "dist/vendor.*.js",
    "limit": "650 kB",
    "gzip": true
  },
  {
    "name": "route-chunks",
    "path": [
      "dist/release-monitor.*.js",
      "dist/namespace-list.*.js",
      "dist/components-list.*.js",
      "dist/issues.[0-9a-f]*.js",
      "dist/issues-overview.*.js",
      "dist/issues-list-page.*.js",
      "dist/tekton-logs.*.js",
      "dist/kubearchive-logs.*.js",
      "dist/[0-9]*.js"
    ],
    "limit": "40 kB",
    "gzip": true
  },
  {
    "name": "main-css",
    "path": "dist/main.css",
    "limit": "8 kB",
    "gzip": true
  },
  {
    "name": "patternfly-css",
    "path": "dist/patternfly.css",
    "limit": "160 kB",
    "gzip": true
  },
  {
    "name": "monaco-css",
    "path": "dist/monaco.css",
    "limit": "18 kB",
    "gzip": true
  },
  {
    "name": "route-chunks-css",
    "path": [
      "dist/kubearchive-logs.css",
      "dist/tekton-logs.css",
      "dist/issues-list-page.css",
      "dist/issues-overview.css",
      "dist/[0-9]*.css"
    ],
    "limit": "6 kB",
    "gzip": true
  }
]
