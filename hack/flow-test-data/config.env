# Flow test data configuration
# Edit these values to match your real repos and branches for end-to-end testing.
# The setup script reads this file before generating YAML templates.

# === Git repositories ===
# Set to your actual forked/cloned repos to trigger real builds.
# Use placeholder URLs for static testing (no builds triggered).

# product-grp1 components
BACKEND_API_REPO="https://github.com/example/backend-api"
BACKEND_API_REVISION="main"

FRONTEND_APP_REPO="https://github.com/example/frontend-app"
FRONTEND_APP_REVISION="main"

WORKER_SVC_REPO="https://github.com/example/worker-svc"
WORKER_SVC_REVISION="main"

SCHEDULER_REPO="https://github.com/example/scheduler"
SCHEDULER_REVISION="main"

MIGRATION_JOB_REPO="https://github.com/example/migration-job"
MIGRATION_JOB_REVISION="main"

CRON_RUNNER_REPO="https://github.com/example/cron-runner"
CRON_RUNNER_REVISION="release-v2"

# platform-infra components
AUTH_PROXY_REPO="https://github.com/example/auth-proxy"
AUTH_PROXY_REVISION="main"

RATE_LIMITER_REPO="https://github.com/example/rate-limiter"
RATE_LIMITER_REVISION="main"

TLS_MANAGER_REPO="https://github.com/example/tls-manager"
TLS_MANAGER_REVISION="main"

CERT_ROTATOR_REPO="https://github.com/example/cert-rotator"
CERT_ROTATOR_REVISION="main"

DNS_RESOLVER_REPO="https://github.com/example/dns-resolver"
DNS_RESOLVER_REVISION="main"

# Nudge targets and ungrouped
OPERATOR_BUNDLE_REPO="https://github.com/example/operator-bundle"
OPERATOR_BUNDLE_REVISION="main"

FBC_CATALOG_REPO="https://github.com/example/fbc-catalog"
FBC_CATALOG_REVISION="main"

SHARED_CONFIG_REPO="https://github.com/example/shared-config"
SHARED_CONFIG_REVISION="main"

LOGGING_SVC_REPO="https://github.com/example/logging-svc"
LOGGING_SVC_REVISION="main"

AUTH_SERVICE_REPO="https://github.com/example/auth-service"
AUTH_SERVICE_REVISION="main"

USER_SERVICE_REPO="https://github.com/example/user-service"
USER_SERVICE_REVISION="main"

NOTIFICATION_SVC_REPO="https://github.com/example/notification-svc"
NOTIFICATION_SVC_REVISION="main"

CACHE_PROXY_REPO="https://github.com/example/cache-proxy"
CACHE_PROXY_REVISION="main"

DATA_PIPELINE_REPO="https://github.com/example/data-pipeline"
DATA_PIPELINE_REVISION="release-v3"

# === Container image registry ===
# Prefix for container image URLs. Component name is appended.
IMAGE_REGISTRY="quay.io/example"

# === Integration test pipelines ===
EC_PIPELINE_REPO="https://github.com/konflux-ci/build-definitions"
EC_PIPELINE_REVISION="main"
EC_PIPELINE_PATH="pipelines/enterprise-contract.yaml"

ITS_PIPELINE_REPO="https://github.com/example/test-pipelines"
ITS_PIPELINE_REVISION="main"
INTEGRATION_TESTS_PATH="pipelines/integration-tests.yaml"
E2E_TESTS_PATH="pipelines/e2e-tests.yaml"
RELEASE_GATE_PATH="pipelines/release-gate.yaml"
